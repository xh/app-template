{
  "name": "hoistapp",
  "version": "1.0-SNAPSHOT",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "rsbuild build --env-mode prod",
    "hoistVer": "cat node_modules/@xh/hoist/package.json | grep version",
    "lint": "pnpm lint:all",
    "lint:all": "pnpm lint:code && pnpm lint:styles",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"**/*.s?(a|c)ss\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "cd .. && husky client-app/.husky",
    "start": "pnpm install && rsbuild dev",
    "startWithIp": "XH_DEV_HOST=$(ipconfig getifaddr en0) pnpm start",
    "startWithHoist": "(cd ../../hoist-react && pnpm install) && pnpm install && rsbuild dev --env-mode inlineHoist"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.s?(a|c)ss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "dependencies": {
    "@xh/hoist": "^91.0.0",
    "ag-grid-community": "~36.3.0",
    "ag-grid-enterprise": "~36.3.0",
    "ag-grid-react": "~36.3.0",
    "core-js": "~3.51.0",
    "highcharts": "~12.6.2",
    "lodash": "~4.18.1",
    "moment": "~2.31.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/lodash": "~4.17.27",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@xh/eslint-config": "~8.1.0",
    "@xh/hoist-dev-utils": "~16.5.0",
    "@xh/hoist-docs": "^1.0.0",
    "cross-env": "~10.1.0",
    "eslint": "~10.15.0",
    "eslint-config-prettier": "~10.1.8",
    "husky": "~9.1.7",
    "jsdom": "~31.0.1",
    "lint-staged": "~17.6.1",
    "msw": "~3.0.7",
    "postcss": "~8.5.33",
    "prettier": "~3.10.1",
    "stylelint": "~18.1.0",
    "stylelint-config-recommended-scss": "~18.0.0",
    "typescript": "~7.0.2",
    "vitest": "~5.1.1"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
